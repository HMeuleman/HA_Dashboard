                let errorLine = "";
                if (error && error !== "OK") {
                  errorLine = `\n⚠️ Error: ${error}`;
                }

                return `File: ${short(filename)}\nLayer: ${layerCur} / ${layerTot}\nFilament: ${filament(filamentUsed)}\nBed: ${bedCur}°C / ${bedTar}°C${errorLine}`;
