  - type: masonry
    path: 3d-printer
    title: 3D Printer
    icon: mdi:printer-3d
    cards:
      - type: grid
        square: false
        columns: 1
        cards:
          - type: custom:button-card
            entity: sensor.3d_printer_print_state
            name: ' '
            show_state: true
            show_label: true
            styles:
              card:
                - padding: 16px
                - border-radius: 12px
                - background: rgba(60,60,60,0.6)
                - color: white
                - font-size: 16px
              icon:
                - width: 80px
                - height: 80px
              state:
                - font-size: 22px
                - font-weight: bold
                - padding-bottom: 8px
              label:
                - icon_height: 50px
                - text-align: left
                - font-size: 16px
                - line-height: 1.4
                - white-space: pre-line
                - opacity: 0.8
            label: |
              [[[
                function fmt(sec) {
                  if (!sec || sec === "unknown" || sec === "unavailable") return "—";
                  sec = Number(sec);
                  const h = Math.floor(sec / 3600);
                  const m = Math.floor((sec % 3600) / 60);
                  const s = sec % 60;
                  return `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
                }

                const dur = states['sensor.3d_printer_print_duration']?.state;
                const rem = states['sensor.3d_printer_time_remaining']?.state;
                const pct = states['sensor.3d_printer_print_progress']?.state;

                let end = "—";
                if (rem && Number(rem) > 0) {
                  const endDate = new Date(Date.now() + Number(rem) * 1000);
                  const hh = endDate.getHours().toString().padStart(2,'0');
                  const mm = endDate.getMinutes().toString().padStart(2,'0');
                  end = `${hh}:${mm}`;
                }

                return `Duration: ${fmt(dur)} (${pct}%)\nRemaining: ${fmt(rem)}\n🕒 End Time: ${end}`;

              ]]]
          - type: picture-entity
            entity: camera.3d_printer_webcam
          - type: horizontal-stack
            cards:
              - show_name: true
                show_icon: true
                type: button
                entity: button.3d_printer_wake_camera
                icon_height: 50px
                show_state: true
                tap_action:
                  action: toggle
              - show_name: true
                show_icon: true
                type: button
                entity: light.3d_printer_light
                icon_height: 50px
          - type: horizontal-stack
            cards:
              - type: custom:button-card
                template: nozzle_temp
                entity: sensor.3d_printer_t0_nozzle_temperature
                name: T0
                label: |
                  [[[
                    const t = states[entity.entity_id.replace('_temperature','_target')]?.state;
                    return "Set: " + Math.round(Number(t)) + "°C";
                  ]]]
              - type: custom:button-card
                template: nozzle_temp
                entity: sensor.3d_printer_t1_nozzle_temperature
                name: T1
                label: |
                  [[[
                    const t = states[entity.entity_id.replace('_temperature','_target')]?.state;
                    return "Set: " + Math.round(Number(t)) + "°C";   
                  ]]]
              - type: custom:button-card
                template: nozzle_temp
                entity: sensor.3d_printer_t2_nozzle_temperature
                name: T2
                label: |
                  [[[
                    const t = states[entity.entity_id.replace('_temperature','_target')]?.state;
                    return "Set: " + Math.round(Number(t)) + "°C";   
                  ]]]
              - type: custom:button-card
                template: nozzle_temp
                entity: sensor.3d_printer_t3_nozzle_temperature
                name: T3
                label: |
                  [[[
                    const t = states[entity.entity_id.replace('_temperature','_target')]?.state;
                    return "Set: " + Math.round(Number(t)) + "°C";   
                  ]]]
          - type: grid
            columns: 4
            square: false
            cards:
              - type: custom:button-card
                entity: button.3d_printer_pause_print
                name: Pause
                icon: mdi:pause
                tap_action:
                  action: call-service
                  service: button.press
                  service_data:
                    entity_id: button.3d_printer_pause_print
                styles:
                  icon:
                    - width: 22px
                    - height: 22px
                  name:
                    - font-size: 12px
                  card:
                    - padding: 10px
                    - border-radius: 10px
                    - background: rgba(255,255,255,0.08)
                    - opacity: |
                        [[[
                          return states['sensor.3d_printer_print_state'].state === 'printing' ? 1 : 0.3;
                        ]]]
                    - pointer-events: |
                        [[[
                          return states['sensor.3d_printer_print_state'].state === 'printing' ? 'auto' : 'none';
                        ]]]
              - type: custom:button-card
                entity: button.3d_printer_resume_print
                name: Resume
                icon: mdi:play
                tap_action:
                  action: call-service
                  service: button.press
                  service_data:
                    entity_id: button.3d_printer_resume_print
                styles:
                  icon:
                    - width: 22px
                    - height: 22px
                  name:
                    - font-size: 12px
                  card:
                    - padding: 10px
                    - border-radius: 10px
                    - background: rgba(255,255,255,0.08)
                    - opacity: |
                        [[[
                          return states['sensor.3d_printer_print_state'].state === 'paused' ? 1 : 0.3;
                        ]]]
                    - pointer-events: |
                        [[[
                          return states['sensor.3d_printer_print_state'].state === 'paused' ? 'auto' : 'none';
                        ]]]
              - type: custom:button-card
                entity: button.3d_printer_cancel_print
                name: Cancel
                icon: mdi:cancel
                tap_action:
                  action: call-service
                  service: button.press
                  service_data:
                    entity_id: button.3d_printer_cancel_print
                confirmation:
                  text: Weet je zeker dat je de print wilt annuleren?
                styles:
                  icon:
                    - width: 22px
                    - height: 22px
                  name:
                    - font-size: 12px
                  card:
                    - padding: 10px
                    - border-radius: 10px
                    - background: rgba(255,80,80,0.25)
              - type: custom:button-card
                entity: button.3d_printer_emergency_stop
                name: STOP
                icon: mdi:alert-octagon
                tap_action:
                  action: call-service
                  service: button.press
                  service_data:
                    entity_id: button.3d_printer_emergency_stop
                confirmation:
                  text: >-
                    NOODSTOP! Printer wordt direct afgebroken. Weet je het
                    zeker?
                styles:
                  icon:
                    - width: 22px
                    - height: 22px
                  name:
                    - font-size: 12px
                  card:
                    - padding: 10px
                    - border-radius: 10px
                    - background: rgba(255,0,0,0.45)
                    - color: white
          - type: custom:apexcharts-card
            header:
              title: 3D Printer Temperatures (Last 30 min)
              show: true
            graph_span: 30min
            apex_config:
              stroke:
                width: 1.5
              grid:
                show: true
                borderColor: '#444444'
                strokeDashArray: 2
                position: back
                xaxis:
                  lines:
                    show: true
                yaxis:
                  lines:
                    show: true
            series:
              - entity: sensor.3d_printer_t0_nozzle_temperature
                name: Nozzle T0
              - entity: sensor.3d_printer_t1_nozzle_temperature
                name: Nozzle T1
              - entity: sensor.3d_printer_t2_nozzle_temperature
                name: Nozzle T2
              - entity: sensor.3d_printer_t3_nozzle_temperature
                name: Nozzle T3
              - entity: sensor.3d_printer_bed_temperature
                name: Bed
              - entity: sensor.3d_printer_cavity
                name: Chamber
      - type: grid
        square: false
        columns: 1
        cards:
          - type: custom:button-card
            show_state: false
            show_label: true
            show_icon: false
            show_name: false
            styles:
              card:
                - padding: 16px
                - border-radius: 12px
                - background: rgba(60,60,60,0.6)
                - color: white
                - font-size: 15px
              icon:
                - display: none
              name:
                - display: none
              label:
                - white-space: pre-line
                - line-height: 1.3
                - font-size: 14px
            label: |
              [[[
                function short(str, max=28) {
                  if (!str) return "—";
                  return str.length > max ? str.slice(0, max) + "…" : str;
                }

                function filament(mm) {
                  if (!mm || mm === "unknown" || mm === "unavailable") return "—";
                  return (Number(mm) / 1000).toFixed(2) + " m";
                }

                const filename = states['sensor.3d_printer_filename']?.state;
                const layerCur = states['sensor.3d_printer_current_layer']?.state;
                const layerTot = states['sensor.3d_printer_total_layers']?.state;

                const bedCur = states['sensor.3d_printer_bed_temperature']?.state;
                const bedTar = states['sensor.3d_printer_bed_target_temperature']?.state;

                const chamberCur = states['sensor.3d_printer_cavity']?.state;

                const filamentUsed = states['sensor.3d_printer_filament_used']?.state;
                const error = states['sensor.3d_printer_error']?.state;

                let errorLine = "";
                if (error && error !== "OK") {
                  errorLine = `\n⚠️ Error: ${error}`;
                }

                return `File: ${short(filename)}\nLayer: ${layerCur} / ${layerTot}\nFilament: ${filament(filamentUsed)}\nBed: ${bedCur}°C / ${bedTar}°C\nChamber: ${chamberCur}°C${errorLine}`;
              ]]]
          - type: picture-entity
            entity: camera.3d_printer_print_preview
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            show_label: false
            styles:
              card:
                - height: 300px
                - position: relative
                - background: >-
                    radial-gradient(circle at 50% 0%, rgba(255,255,255,0.08),
                    rgba(0,0,0,0.9))
                - border-radius: 14px
                - overflow: hidden
                - padding: 0
              custom_fields:
                bed:
                  - position: absolute
                  - left: 50%
                  - top: 62%
                  - width: 70%
                  - height: 40%
                  - transform: translateX(-50%) skewX(-30deg)
                  - border: 1px solid rgba(255,255,255,0.35)
                  - background-image: >-
                      repeating-linear-gradient(0deg, rgba(255,255,255,0.08),
                      rgba(255,255,255,0.08) 2px, transparent 2px, transparent
                      10px), repeating-linear-gradient(90deg,
                      rgba(255,255,255,0.08), rgba(255,255,255,0.08) 2px,
                      transparent 2px, transparent 10px)
                  - box-shadow: 0 18px 30px rgba(0,0,0,0.8)
                  - border-radius: 6px
                head:
                  - position: absolute
                  - transition: all 0.12s linear
                  - width: 100%
                  - height: 100%
                debug:
                  - position: absolute
                  - left: 5%
                  - top: 15%
                  - width: 90%
                  - background: rgba(0,0,0,0.4)
                  - padding: 8px
                  - border-radius: 8px
                  - font-size: 12px
                  - color: white
            custom_fields:
              bed: |
                [[[
                  return '<div></div>';
                ]]]
              head: |
                [[[
                  const raw = states['sensor.3d_printer_toolhead_position']?.state || "";
                  const match = raw.match(/X\s*(-?[\d.]+)\s*Y\s*(-?[\d.]+)\s*Z\s*(-?[\d.]+)/i);
                  if (!match) return "";

                  const X = parseFloat(match[1]);
                  const Y = parseFloat(match[2]);
                  const Z = parseFloat(match[3]);

                  const maxX = 275;
                  const maxY = 275;
                  const maxZ = 275;

                  const nx = X / maxX;
                  const ny = Y / maxY;
                  const nz = Z / maxZ;
                  
                  // perspectief: schuin van rechts-boven
                  const isoX = nx + ny * 0.22;
                  const isoY = ny 
                  
                  const left = 5 + isoX * 71;
                  const top  = 95 - isoY * 37;

                  const hue = 220 - nz * 160;
                  const color = `hsl(${hue}, 80%, 60%)`;
                  const shadow = `0 10px 18px rgba(0,0,0,${0.35 + (1 - nz) * 0.35})`;

                  return `<div style="position: absolute; left:${left}%; top:${top}%; width:16px; height:16px; border-radius:50%; background:${color}; box-shadow:${shadow}; display:flex; align-items:center; justify-content:center; font-size:10px; color:#fff; border:1px solid rgba(255,255,255,0.7); text-shadow:0 1px 2px rgba(0,0,0,0.8);">▲</div>`;
                ]]]
              debug: |
                [[[
                  const raw = states['sensor.3d_printer_toolhead_position']?.state || "NO RAW VALUE";
                  const match = raw.match(/X\s*([\d.]+)\s*Y\s*([\d.]+)\s*Z\s*([\d.]+)/i);

                  if (!match) {
                    return `RAW=${raw} | Calibrating?`;
                  }

                  const X = parseFloat(match[1]);
                  const Y = parseFloat(match[2]);
                  const Z = parseFloat(match[3]);

                  return `X=${X} Y=${Y} Z=${Z}`;
                ]]]
          - type: entities
            entities:
              - entity: binary_sensor.3d_printer_error
                name: Error
              - entity: sensor.3d_printer_filament_used
                name: Filament Used
              - entity: sensor.3d_printer_klipper_state
                name: Klipper State
              - entity: sensor.3d_printer_part_cooling_fan
                name: Part Cooling Fan
